# Скопируйте этот файл в .env и заполните значения.
# .env НЕ коммитить в git (он уже в .gitignore)!

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=8630641864:AAEJbrTd3_npJTAAnGZ32gDiqfGY9sEeQRU

# --- Необязательные настройки (значения по умолчанию показаны) ---

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
#LOG_LEVEL=INFO

# Максимум треков в одном плейлисте (защита от абьюза)
#MAX_PLAYLIST_TRACKS=500

# Интервал между обновлениями сообщения прогресса, сек (не ниже 1.5!)
#PROGRESS_UPDATE_INTERVAL=2.5

# Сколько плейлистов бот обрабатывает одновременно (остальные в очереди)
#MAX_ACTIVE_JOBS=3

# Глобальный лимит одновременных скачиваний треков
#GLOBAL_DOWNLOAD_CONCURRENCY=2

# Таймаут на всю работу (сек) и на один трек (сек)
#JOB_TIMEOUT_SECONDS=3600
#TRACK_TIMEOUT_SECONDS=600

# Рабочий каталог для временных файлов (по умолчанию — системный temp).
# Укажите, например, если /tmp в памяти (tmpfs) и места мало:
#WORK_DIR=/var/lib/soundcloud_bot/tmp

# Fallback на случай, если yt-dlp не смог сам получить client_id SoundCloud
# (обычно НЕ нужен; значение можно взять из запросов браузера к api-v2.soundcloud.com)
#SOUNDCLOUD_CLIENT_ID=

# Свой User-Agent при проблемах с блокировками
#SOUNDCLOUD_USER_AGENT=

# --- Подписки (автодобавление новых треков в привязанные плейлисты) ---

# Как часто фоновый монитор проверяет привязанные плейлисты (сек)
#PLAYLIST_CHECK_INTERVAL=1800

# Максимум подписок на одного пользователя
#MAX_SUBSCRIPTIONS_PER_USER=5

# Максимум новых треков, рассылаемых за одну проверку (защита от перезалива)
#MAX_NEW_TRACKS_PER_CHECK=10

# Пауза между автоотправками треков (сек, бережём лимиты Telegram)
#SEND_DELAY_SECONDS=3

# --- Кэш треков (повторные запросы отдаются мгновенно) ---

# Включить кэш (1 = да, 0 = нет)
#CACHE_ENABLED=1

# Каталог кэша (по умолчанию — cache/ рядом с проектом)
#CACHE_DIR=

# Сколько часов трек хранится в кэше с последнего использования
#CACHE_TTL_HOURS=72

# Максимальный размер кэша, МБ (при переполнении удаляются самые старые)
#CACHE_MAX_SIZE_MB=2048
